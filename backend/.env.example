# Copy to backend/.env and fill in. Never commit backend/.env.
# Space-Track (primary catalog, SATCAT for the Sentinel watchlist): https://www.space-track.org/auth/createAccount
SPACETRACK_USER=
SPACETRACK_PASS=
# N2YO REST v1 ("what's up" and visual passes): https://www.n2yo.com/api/
N2YO_API_KEY=
# Optional Sentinel notifications via a Telegram bot (both needed; nothing is sent if either is missing).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
